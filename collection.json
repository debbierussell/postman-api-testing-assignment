  "item": [
    {
      "name": "01 - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r",
              "\r",
              "// Store the access token\r",
              "if (jsonData.accessToken) {\r",
              "    pm.environment.set(\"token\", jsonData.accessToken);\r",
              "    console.log(\"Token stored successfully!\");\r",
              "}\r",
              "\r",
              "// Tests\r",
              "pm.test(\"Login successful - status 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Access token received\", function () {\r",
              "    pm.expect(jsonData.accessToken).to.exist;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"emilys\",\"password\":\"emilyspass\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
