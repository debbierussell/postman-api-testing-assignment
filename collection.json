              "    pm.expect(pm.response.json().id).to.exist;\r",
              "});\r",
              "pm.test(\"Product has a title\", function () {\r",
              "    pm.expect(pm.response.json().title).to.exist;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
