              "if (jsonData.id) {\r",
              "    pm.environment.set(\"product_id\", jsonData.id);\r",
              "    console.log(\"Product ID saved: \" + jsonData.id);\r",
              "}\r",
              "pm.test(\"Product ID exists\", function () {\r",
              "    pm.expect(jsonData.id).to.exist;\r",
              "});"
