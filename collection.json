  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "// Auto-login if token is missing\r",
          "var token = pm.environment.get(\"token\");\r",
          "\r",
          "if (!token || token === \"\") {\r",
          "    pm.sendRequest({\r",
          "        url: \"https://dummyjson.com/auth/login\",\r",
          "        method: \"POST\",\r",
          "        header: {\r",
          "            \"Content-Type\": \"application/json\"\r",
          "        },\r",
          "        body: {\r",
          "            mode: \"raw\",\r",
          "            raw: JSON.stringify({\r",
          "                username: \"emilys\",\r",
          "                password: \"emilyspass\"\r",
          "            })\r",
          "        }\r",
          "    }, function (err, res) {\r",
          "        if (!err) {\r",
          "            var jsonData = res.json();\r",
          "            if (jsonData.accessToken) {\r",
          "                pm.environment.set(\"token\", jsonData.accessToken);\r",
          "                console.log(\"Token auto-refreshed!\");\r",
          "            }\r",
          "        }\r",
          "    });\r",
          "}"
        ]
      }
    },
